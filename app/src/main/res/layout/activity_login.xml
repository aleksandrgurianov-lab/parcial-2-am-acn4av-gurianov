<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/pt_default">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/orange_premium"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/m_32"
            android:text="@string/login_title"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_subtitle" />

        <EditText
            android:id="@+id/etLoginEmail"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:layout_marginBottom="@dimen/m_18"
            android:background="@color/input"
            android:hint="@string/correo"
            android:inputType="textEmailAddress"
            android:padding="@dimen/p_sides"
            android:textColor="@color/white"
            android:textColorHint="@color/text_secondary" />

        <EditText
            android:id="@+id/etLoginPassword"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:layout_marginBottom="@dimen/pt_default"
            android:background="@color/input"
            android:hint="@string/pass"
            android:inputType="textPassword"
            android:padding="@dimen/p_sides"
            android:textColor="@color/white"
            android:textColorHint="@color/text_secondary" />

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:backgroundTint="@color/orange_premium"
            android:text="@string/btn_login"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnGoToRegister"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/m_18"
            android:text="@string/link_crear"
            android:textColor="@color/color_curso" />

    </LinearLayout>
</ScrollView>