<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/m_18">

        <include layout="@layout/layout_header" />

        <!-- API curso de cambio -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/pt_default"
            android:background="@color/bg_curso"
            android:orientation="vertical"
            android:padding="@dimen/p_sides">

            <TextView
                android:id="@+id/tvApiStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/curso_loading"
                android:textColor="@color/color_curso"
                android:textSize="@dimen/text_size_body" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/m_18"
            android:text="@string/hoteles_disponibles"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_subtitle_2"
            android:textStyle="bold" />

        <!-- Variantes -->
        <LinearLayout
            android:id="@+id/cardPalermoLoft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/m_18"
            android:background="@color/bg_curso"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="@dimen/m_18">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loft_title"
                android:textColor="@color/orange_premium"
                android:textSize="@dimen/text_size_subtitle"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pt_default"
                android:text="@string/hotel_cat_descr"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/m_8"
                android:text="@string/hotel_cat_precio"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_size_subtitle"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>